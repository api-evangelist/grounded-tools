          "name": "Grounded.tools Connect to MCP server via Server-Sent Events",
          "request": {
            "name": "Grounded.tools Connect to MCP server via Server-Sent Events",
            "description": {
              "content": "Establishes a Server-Sent Events (SSE) connection to the MCP server. This is the primary endpoint for MCP client connections. The server streams MCP protocol messages including tool results, resource data, and notifications over this persistent connection.",
